# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[*.{swift,kt,kts,gradle,rs,py,xml}]
indent_style = space
indent_size = 4

[*.{yml,yaml,json,toml,proto,html,css,js,sh}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab

# Licence texts are kept verbatim.
[{LICENSE,LICENSES/**}]
trim_trailing_whitespace = false
insert_final_newline = unset
